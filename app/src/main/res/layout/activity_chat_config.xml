<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:background="@color/card_background">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="?attr/homeAsUpIndicator"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_back" />

        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/on_surface" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Endpoint -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chat_config_endpoint_label"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="13sp"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/endpointInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/chat_config_endpoint_hint"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:padding="12dp"
                        android:background="@drawable/edit_text_bg" />

                    <TextView
                        android:id="@+id/endpointPreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:textSize="12sp"
                        android:textColor="@color/on_surface_variant"
                        android:paddingTop="8dp"
                        android:paddingHorizontal="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- API Key -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chat_config_api_key_label"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="13sp"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/apiKeyInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="sk-..."
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:padding="12dp"
                        android:background="@drawable/edit_text_bg" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Model -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chat_config_model_label"
                        android:fontFamily="sans-serif-medium"
                        android:textSize="13sp"
                        android:textColor="@color/on_surface"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/modelInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/chat_config_model_hint"
                        android:fontFamily="sans-serif"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:singleLine="true"
                        android:padding="12dp"
                        android:background="@drawable/edit_text_bg" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Advanced: collapsible card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/card_background"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_variant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/advancedHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/chat_config_advanced"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="14sp"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:id="@+id/advancedChevron"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▸"
                            android:textSize="18sp"
                            android:textColor="@color/on_surface_variant" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/advancedContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginTop="12dp">

                        <!-- Streaming Toggle -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="16dp"
                            android:padding="12dp"
                            android:background="@drawable/edit_text_bg">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/chat_config_streaming"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="14sp"
                                android:textColor="@color/on_surface" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/streamingSwitch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                        </LinearLayout>

                        <!-- System Prompt -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chat_config_system_prompt"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="13sp"
                            android:textColor="@color/on_surface"
                            android:layout_marginBottom="8dp" />

                        <EditText
                            android:id="@+id/systemPromptInput"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:hint="@string/chat_config_system_prompt_hint"
                            android:fontFamily="sans-serif"
                            android:textSize="14sp"
                            android:gravity="top"
                            android:inputType="textMultiLine"
                            android:padding="12dp"
                            android:background="@drawable/edit_text_bg"
                            android:layout_marginBottom="16dp" />

                        <!-- Max Tokens -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/chat_config_max_tokens"
                            android:fontFamily="sans-serif-medium"
                            android:textSize="13sp"
                            android:textColor="@color/on_surface"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <SeekBar
                                android:id="@+id/maxTokensSeekBar"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="15"
                                android:progress="3" />

                            <TextView
                                android:id="@+id/maxTokensLabel"
                                android:layout_width="60dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:textSize="13sp"
                                android:textColor="@color/on_surface"
                                android:gravity="end"
                                android:text="4000" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/chat_config_save"
                app:cornerRadius="16dp"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
