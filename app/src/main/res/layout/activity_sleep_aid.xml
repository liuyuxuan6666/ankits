<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/background"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/backBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="返回"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="?attr/homeAsUpIndicator" />

                <TextView
                    android:id="@+id/toolbarTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="小助眠"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/on_surface" />

                <ImageView
                    android:id="@+id/settingsBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/settings"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_settings" />

            </LinearLayout>

            <!-- Built-in Sounds Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:strokeWidth="1dp"
                app:strokeColor="@color/outline_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/builtinSoundHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sleep_aid_builtin_sounds"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:id="@+id/builtinSoundChevron"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▾"
                            android:textSize="14sp"
                            android:textColor="@color/on_surface_variant" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/builtinSoundContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- My Audio Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:strokeWidth="1dp"
                app:strokeColor="@color/outline_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/myAudioHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sleep_aid_my_audio"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:id="@+id/myAudioChevron"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▸"
                            android:textSize="14sp"
                            android:textColor="@color/on_surface_variant" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/myAudioContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="4dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/importAudioBtn"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:text="@string/sleep_aid_import_audio"
                                android:textSize="13sp"
                                app:strokeColor="@color/outline"
                                app:cornerRadius="12dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/importVideoBtn"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="@string/sleep_aid_import_video"
                                android:textSize="13sp"
                                app:strokeColor="@color/outline"
                                app:cornerRadius="12dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/importedAudioList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="8dp" />

                        <CheckBox
                            android:id="@+id/shuffleToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/sleep_aid_shuffle"
                            android:textSize="13sp"
                            android:textColor="@color/on_surface"
                            android:buttonTint="@color/primary" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Timer Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:strokeWidth="1dp"
                app:strokeColor="@color/outline_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/timerHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sleep_aid_timer"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:id="@+id/timerChevron"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▸"
                            android:textSize="14sp"
                            android:textColor="@color/on_surface_variant" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/timerContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/timerChips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleLine="false"
                            app:singleSelection="true"
                            app:selectionRequired="false"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="6dp" />

                        <LinearLayout
                            android:id="@+id/customTimerRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginTop="8dp"
                            android:visibility="gone">

                            <NumberPicker
                                android:id="@+id/timerMinutesPicker"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="分钟"
                                android:textSize="14sp"
                                android:textColor="@color/on_surface" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/timerRemainingText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/sleep_aid_timer_off"
                            android:textSize="12sp"
                            android:textColor="@color/on_surface_variant" />

                        <CheckBox
                            android:id="@+id/fadeOutToggle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/sleep_aid_fade_out"
                            android:textSize="13sp"
                            android:textColor="@color/on_surface"
                            android:checked="true"
                            android:buttonTint="@color/primary" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@color/background"
        android:elevation="8dp">

        <ImageButton
            android:id="@+id/skipPrevBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="?attr/homeAsUpIndicator"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sleep_aid_notification_prev"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/playBtn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/sleep_aid_play"
            android:textSize="16sp"
            app:cornerRadius="28dp" />

        <ImageButton
            android:id="@+id/skipNextBtn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="?attr/homeAsUpIndicator"
            android:scaleX="-1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sleep_aid_notification_next"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
