<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/background"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/backBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="返回"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="?attr/homeAsUpIndicator" />

                <TextView
                    android:id="@+id/toolbarTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tool_text_to_image"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="@color/on_surface" />

                <ImageView
                    android:id="@+id/settingsBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/settings"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_settings" />

            </LinearLayout>

            <!-- Text Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="@string/hint_text_input"
                app:hintTextColor="@color/primary"
                app:boxStrokeColor="@color/outline"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxBackgroundColor="@color/card_background"
                app:boxCornerRadiusBottomEnd="20dp"
                app:boxCornerRadiusBottomStart="20dp"
                app:boxCornerRadiusTopEnd="20dp"
                app:boxCornerRadiusTopStart="20dp"
                app:counterEnabled="true"
                app:counterMaxLength="10000"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="200dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:textSize="15sp"
                    android:lineSpacingExtra="6sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/on_surface"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Size Selector -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:strokeWidth="1dp"
                app:strokeColor="@color/outline_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/sizeHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_size"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:id="@+id/sizeChevron"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▾"
                            android:textSize="14sp"
                            android:textColor="@color/on_surface_variant" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sizeContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/sizeChips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleLine="false"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="6dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Template Selector -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:strokeWidth="1dp"
                app:strokeColor="@color/outline_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/templateHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="模板"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:id="@+id/templateChevron"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▾"
                            android:textSize="14sp"
                            android:textColor="@color/on_surface_variant" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/templateContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/templateChips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:singleLine="false"
                            app:chipSpacingHorizontal="8dp"
                            app:chipSpacingVertical="6dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Style Config Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/card_background"
                app:strokeWidth="1dp"
                app:strokeColor="@color/outline_variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/styleHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="样式"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_surface" />

                        <TextView
                            android:id="@+id/styleChevron"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▾"
                            android:textSize="14sp"
                            android:textColor="@color/on_surface_variant" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/styleContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <!-- Background Color -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_bg_color"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_surface_variant"
                            android:layout_marginBottom="4dp"
                            android:letterSpacing="0.05" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <EditText
                                android:id="@+id/bgColorInput"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="#FFFFFF"
                                android:inputType="text"
                                android:textSize="14sp"
                                android:textColor="@color/on_surface"
                                android:background="@drawable/edit_text_bg"
                                android:gravity="start|center_vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:fontFamily="sans-serif"
                                android:maxLines="1" />

                            <View
                                android:id="@+id/bgColorSwatch"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/color_swatch_bg" />

                        </LinearLayout>

                        <!-- Text Color -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_text_color"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_surface_variant"
                            android:layout_marginBottom="4dp"
                            android:letterSpacing="0.05" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <EditText
                                android:id="@+id/textColorInput"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:text="#333333"
                                android:inputType="text"
                                android:textSize="14sp"
                                android:textColor="@color/on_surface"
                                android:background="@drawable/edit_text_bg"
                                android:gravity="start|center_vertical"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:fontFamily="sans-serif"
                                android:maxLines="1" />

                            <View
                                android:id="@+id/textColorSwatch"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_marginStart="12dp"
                                android:background="@drawable/color_swatch_bg" />

                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/outline_variant"
                            android:layout_marginVertical="4dp" />

                        <!-- Font Size -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_font_size"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_surface_variant"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="2dp"
                            android:letterSpacing="0.05" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <SeekBar
                                android:id="@+id/fontSizeSeek"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="60"
                                android:progress="20" />

                            <TextView
                                android:id="@+id/fontSizeLabel"
                                android:layout_width="44dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="40sp"
                                android:textSize="13sp"
                                android:textColor="@color/on_surface" />

                        </LinearLayout>

                        <!-- Line Spacing -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_line_spacing"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/on_surface_variant"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="2dp"
                            android:letterSpacing="0.05" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <SeekBar
                                android:id="@+id/lineSpacingSeek"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:max="88"
                                android:progress="20" />

                            <TextView
                                android:id="@+id/lineSpacingLabel"
                                android:layout_width="44dp"
                                android:layout_height="wrap_content"
                                android:gravity="end"
                                android:text="1.30x"
                                android:textSize="13sp"
                                android:textColor="@color/on_surface" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Fixed Bottom Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@color/background"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/previewBtn"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/btn_preview"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportBtn"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="12dp"
            android:text="@string/btn_export"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>
