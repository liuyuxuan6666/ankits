<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ankits">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Ankits">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TextToImageActivity"
            android:exported="false"
            android:theme="@style/Theme.Ankits"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".MetronomeActivity"
            android:exported="false"
            android:theme="@style/Theme.Ankits"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".TunerActivity"
            android:exported="false"
            android:theme="@style/Theme.Ankits"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SpeechToTextActivity"
            android:exported="false"
            android:theme="@style/Theme.Ankits"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".OcrActivity"
            android:exported="false"
            android:theme="@style/Theme.Ankits"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Ankits"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".SleepAidActivity"
            android:exported="false"
            android:theme="@style/Theme.Ankits"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".PomodoroActivity"
            android:exported="false"
            android:theme="@style/Theme.Ankits"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.Ankits"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ChatConfigActivity"
            android:exported="false"
            android:theme="@style/Theme.Ankits"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".PomodoroSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Ankits"
            android:parentActivityName=".PomodoroActivity" />

        <activity
            android:name=".ChatSessionListActivity"
            android:exported="false"
            android:theme="@style/Theme.Ankits"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".MetronomeService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
